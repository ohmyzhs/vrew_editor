{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vrew 자동 편집기",
  "version": "0.2.1",
  "identifier": "com.mandamtube.vrew-auto-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vrew 자동 편집기",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 720,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  }
}
